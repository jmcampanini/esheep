{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:best-practices", ":disableDependencyDashboard"],
  "enabledManagers": ["mise", "gomod", "github-actions"],
  "prConcurrentLimit": 0,
  "prHourlyLimit": 0,
  "labels": ["dependencies"],
  "lockFileMaintenance": {
    "automerge": true
  },
  "postUpdateOptions": ["gomodTidy", "gomodUpdateImportPaths"],
  "packageRules": [
    {
      "matchManagers": ["gomod"],
      "addLabels": ["go"],
      "constraintsFiltering": "strict"
    },
    {
      "matchManagers": ["gomod"],
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "groupName": "go minor and patch"
    },
    {
      "matchManagers": ["github-actions"],
      "addLabels": ["github-actions"],
      "groupName": "actions"
    },
    {
      "matchManagers": ["mise"],
      "addLabels": ["mise"]
    },
    {
      "matchManagers": ["mise"],
      "matchUpdateTypes": ["minor"],
      "groupName": "mise minor"
    },
    {
      "description": "govulncheck versions are looked up with a leading v and the pin in mise.toml has none.",
      "matchManagers": ["mise"],
      "matchDepNames": ["go:golang.org/x/vuln/cmd/govulncheck"],
      "extractVersion": "^v(?<version>.+)$"
    },
    {
      "description": "Look up the go pin in mise.toml where the go directive in go.mod is looked up, so both see a new release in the same run.",
      "matchManagers": ["mise"],
      "matchDepNames": ["go"],
      "overrideDatasource": "golang-version",
      "overridePackageName": "go",
      "extractVersion": "^(?<version>.+)$"
    },
    {
      "matchManagers": ["mise", "gomod"],
      "matchDepNames": ["go"],
      "groupName": "go toolchain",
      "rangeStrategy": "bump",
      "addLabels": ["go"]
    },
    {
      "description": "mise pins the development tools, so their patch updates get a group of their own that merges once the required checks pass. The go pin is left out because the Go toolchain compiles the released binaries and stays in the go toolchain group.",
      "matchManagers": ["mise"],
      "matchDepNames": ["!go"],
      "matchUpdateTypes": ["patch"],
      "groupName": "mise patch",
      "automerge": true
    },
    {
      "description": "Action updates below a major only change CI, so a bad one fails the required checks. Majors get their own branch, so the actions branch never holds a manual update.",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["!major"],
      "automerge": true
    },
    {
      "description": "actions/attest-build-provenance runs only in the tag-triggered release workflow, where no required check exercises it. Its own group keeps it off the actions branch.",
      "matchManagers": ["github-actions"],
      "matchDepNames": ["actions/attest-build-provenance"],
      "groupName": "release actions",
      "automerge": false
    }
  ]
}
