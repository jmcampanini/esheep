{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:best-practices", ":disableDependencyDashboard"],
  "enabledManagers": ["mise", "gomod", "github-actions"],
  "prConcurrentLimit": 0,
  "prHourlyLimit": 0,
  "labels": ["dependencies"],
  "lockFileMaintenance": {
    "automerge": true
  },
  "postUpdateOptions": ["gomodTidy", "gomodUpdateImportPaths"],
  "packageRules": [
    {
      "matchManagers": ["gomod"],
      "addLabels": ["go"],
      "constraintsFiltering": "strict"
    },
    {
      "matchManagers": ["gomod"],
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "groupName": "go minor and patch"
    },
    {
      "matchManagers": ["github-actions"],
      "addLabels": ["github-actions"],
      "groupName": "actions"
    },
    {
      "matchManagers": ["mise"],
      "addLabels": ["mise"]
    },
    {
      "matchManagers": ["mise"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "mise minor and patch"
    },
    {
      "description": "govulncheck versions are looked up with a leading v and the pin in mise.toml has none.",
      "matchManagers": ["mise"],
      "matchDepNames": ["go:golang.org/x/vuln/cmd/govulncheck"],
      "extractVersion": "^v(?<version>.+)$"
    },
    {
      "description": "Look up the go pin in mise.toml where the go directive in go.mod is looked up, so both see a new release in the same run.",
      "matchManagers": ["mise"],
      "matchDepNames": ["go"],
      "overrideDatasource": "golang-version",
      "overridePackageName": "go",
      "extractVersion": "^(?<version>.+)$"
    },
    {
      "matchManagers": ["mise", "gomod"],
      "matchDepNames": ["go"],
      "groupName": "go toolchain",
      "rangeStrategy": "bump",
      "addLabels": ["go"]
    },
    {
      "description": "Action updates below a major only change CI, so a bad one fails the required checks. actions/attest-build-provenance stays manual because it runs only in the tag-triggered release workflow, where no required check exercises it.",
      "matchManagers": ["github-actions"],
      "matchDepNames": ["!actions/attest-build-provenance"],
      "matchUpdateTypes": ["minor", "patch", "digest", "pin", "pinDigest"],
      "automerge": true
    },
    {
      "description": "mise pins the development tools, so their patch updates merge once the required checks pass. The go pin stays manual because the Go toolchain compiles the released binaries and moves together with the go directive in go.mod.",
      "matchManagers": ["mise"],
      "matchDepNames": ["!go"],
      "matchUpdateTypes": ["patch"],
      "automerge": true
    }
  ]
}
